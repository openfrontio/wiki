---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrowseSidebar from "../../components/BrowseSidebar.astro";
import audit from "../../data/github-source-audit.json";
---

<Layout title="Source Tree Audit — OpenFront Wiki" description="Coverage audit of live OpenFrontIO game source files against the OpenFront Wiki source references.">
  <SiteHeader />
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore>
      <details open><summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">Browse Pages <span class="lg:hidden">▾</span></summary><BrowseSidebar /></details>
    </aside>
    <main class="min-w-0">
      <nav class="mb-6 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore><a href="/" class="hover:text-aquarius">Home</a><span>/</span><span class="text-dawn">Source tree audit</span></nav>
      <header class="border-b border-white/10 pb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Live source coverage</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">Source tree audit</h1>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-dawn/80">This inventory checks the live OpenFrontIO tree for game, configuration, schema, and map-generator files. Uncovered files are candidates for new mechanics pages or source mappings; they are not automatically treated as player-facing systems.</p>
        <div class="mt-5 flex flex-wrap gap-4 text-sm text-dawn/70"><span>{audit.totalFiles} source files</span><span>{audit.coveredFiles.length} mapped</span><span>{audit.uncoveredFiles.length} system candidates</span><span>{audit.mapDataFiles.length} map data files</span><a href={`https://github.com/${audit.repository}/commit/${audit.revision}`} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">Commit {audit.revision.slice(0, 7)} ↗</a></div>
      </header>
      <div class="mt-8 space-y-8" data-pagefind-body>
        <section>
          <h2 class="font-display text-2xl font-bold text-white">Uncovered source files</h2>
          <p class="mt-1 text-sm text-dawn/70">These files are visible in the live source scope but are not yet directly mapped by the wiki reference layer.</p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">{audit.uncoveredFiles.map((file) => <li class="rounded-lg border border-white/10 bg-navy-700/50 px-3 py-2 text-sm"><a href={`https://github.com/${audit.repository}/blob/${audit.revision}/${file}`} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">{file}</a></li>)}</ul>
        </section>
        <section>
          <h2 class="font-display text-2xl font-bold text-white">Mapped source files</h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">{audit.coveredFiles.map((file) => <li class="rounded-lg border border-white/10 bg-navy-700/40 px-3 py-2 text-sm"><a href={`https://github.com/${audit.repository}/blob/${audit.revision}/${file}`} target="_blank" rel="noopener noreferrer" class="text-dawn/70 hover:text-white">{file}</a></li>)}</ul>
        </section>
        <section>
          <h2 class="font-display text-2xl font-bold text-white">Map data inventory</h2>
          <p class="mt-1 text-sm text-dawn/70">Map metadata files are tracked separately from mechanic candidates because they describe the map catalogue rather than new game systems.</p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">{audit.mapDataFiles.map((file) => <li class="rounded-lg border border-white/10 bg-navy-700/40 px-3 py-2 text-sm"><a href={`https://github.com/${audit.repository}/blob/${audit.revision}/${file}`} target="_blank" rel="noopener noreferrer" class="text-dawn/70 hover:text-white">{file}</a></li>)}</ul>
        </section>
      </div>
    </main>
  </div>
  <SiteFooter />
</Layout>