---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrowseSidebar from "../../components/BrowseSidebar.astro";
import { INTERNAL_GAME_ENTITIES, LIVE_GAME_REVISION, MISSING_LIVE_MAPS } from "../../data/live-game-registry.js";
---

<Layout title="Live Game Registry — OpenFront Wiki" description="Maps and implementation entities found in the current OpenFrontIO source but not previously represented in the wiki manifest.">
  <SiteHeader />
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore>
      <details open><summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">Browse Pages <span class="lg:hidden">▾</span></summary><BrowseSidebar /></details>
    </aside>
    <main class="min-w-0">
      <nav class="mb-6 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore><a href="/" class="hover:text-aquarius">Home</a><span>/</span><span class="text-dawn">Live registry</span></nav>
      <header class="border-b border-white/10 pb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Coverage audit</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">Live game registry</h1>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-dawn/80">These entries were found in the current OpenFrontIO source and added to the wiki during the coverage audit. The registry is pinned to commit <code>{LIVE_GAME_REVISION.slice(0, 7)}</code>.</p>
      </header>
      <div class="mt-8 space-y-10" data-pagefind-body>
        <section>
          <h2 class="font-display text-2xl font-bold text-white">New map pages</h2>
          <p class="mt-1 text-sm text-dawn/70">Eight maps were present in the live registry without matching wiki titles.</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {MISSING_LIVE_MAPS.map((map) => <a href={`/maps/${map.slug}`} class="group rounded-xl border border-white/10 bg-navy-700/50 p-4 hover:border-malibu/50"><span class="text-xs uppercase tracking-widest text-cyan-glow/80">{map.categories.join(" / ")}</span><h3 class="mt-2 font-display text-lg font-semibold text-white group-hover:text-aquarius">{map.title}</h3><p class="mt-1 text-sm text-dawn/60">{map.nations} default nations · Read map page →</p></a>)}
          </div>
        </section>
        <section>
          <h2 class="font-display text-2xl font-bold text-white">Implementation entities</h2>
          <p class="mt-1 text-sm text-dawn/70">These are live code entities, but they are not independently buildable player units.</p>
          <div class="mt-4 overflow-x-auto rounded-xl border border-white/10"><table class="w-full min-w-[600px] text-left text-sm"><thead class="bg-navy-700/80 text-xs uppercase tracking-wider text-dawn/60"><tr><th class="px-4 py-3">Entity</th><th class="px-4 py-3">Kind</th><th class="px-4 py-3">Role</th><th class="px-4 py-3">Source</th></tr></thead><tbody class="divide-y divide-white/10 bg-navy-700/40">{INTERNAL_GAME_ENTITIES.map((entity) => <tr><th scope="row" class="px-4 py-3 font-medium text-white">{entity.name}</th><td class="px-4 py-3 text-aquarius">{entity.kind}</td><td class="px-4 py-3 text-dawn/70">{entity.description}</td><td class="px-4 py-3"><a href={entity.source} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">Game.ts ↗</a></td></tr>)}</tbody></table></div>
        </section>
      </div>
    </main>
  </div>
  <SiteFooter />
</Layout>