---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrowseSidebar from "../../components/BrowseSidebar.astro";
import { GITHUB_GAME_DATA, githubSourceUrl } from "../../data/github-game-data.js";
import { GITHUB_SOURCE_FILES } from "../../data/github-references.js";

const allEntries = GITHUB_GAME_DATA.sections.flatMap((section) => section.entries);
const entry = (label) => allEntries.find((item) => item.label === label);
const numberFrom = (label) => Number(entry(label)?.value.replace(/[^0-9]/g, "") || 0);
const costChart = ["City", "Defense Post", "Warship", "Missile Silo", "SAM Launcher", "Atom Bomb", "Hydrogen Bomb", "MIRV launch"].map((label) => ({
  label,
  value: numberFrom(label),
}));
const maxCost = Math.max(...costChart.map((item) => item.value));
const clockChart = [
  { label: "Warning", value: 30, color: "bg-cyan-glow" },
  { label: "Troop ramp", value: 90, color: "bg-malibu" },
  { label: "Territory deadline", value: numberFrom("Territory elimination deadline"), color: "bg-territory" },
];
---

<Layout title="Game Data Reference — OpenFront Wiki" description="A versioned reference of OpenFront game values checked against the OpenFrontIO GitHub source.">
  <SiteHeader />

  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)] xl:grid-cols-[230px_minmax(0,1fr)_200px]">
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore>
      <details open>
        <summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">Browse Pages <span class="lg:hidden">▾</span></summary>
        <BrowseSidebar />
      </details>
    </aside>

    <main class="min-w-0">
      <nav class="mb-6 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore>
        <a href="/" class="hover:text-aquarius">Home</a><span>/</span><a href="/category/game-database" class="hover:text-aquarius">Game Database</a><span>/</span><span class="text-dawn">Source-backed data</span>
      </nav>

      <header class="border-b border-white/10 pb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">OpenFrontIO source reference</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">Game data</h1>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-dawn/80">
          A versioned snapshot of selected gameplay values from the OpenFrontIO codebase. These values are references for the current revision, not timeless rules: balance changes may update them.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-dawn/60">
          <span>Checked {GITHUB_GAME_DATA.checkedAt}</span>
          <a href={`https://github.com/${GITHUB_GAME_DATA.repository}/commit/${GITHUB_GAME_DATA.revision}`} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">Commit {GITHUB_GAME_DATA.revision.slice(0, 7)} →</a>
        </div>
      </header>

      <section class="mt-8 grid gap-4 lg:grid-cols-2" data-pagefind-ignore>
        <figure class="data-visual-panel">
          <figcaption><span>Base cost scale</span><small>Gold · relative comparison</small></figcaption>
          <div class="mt-5 space-y-3">
            {costChart.map((item) => <div class="data-bar-row"><span>{item.label}</span><div class="data-bar-track"><span class="data-bar bg-malibu" style={`width: ${Math.max(3, (item.value / maxCost) * 100)}%`}></span></div><strong>{item.value.toLocaleString()}</strong></div>)}
          </div>
        </figure>
        <figure class="data-visual-panel">
          <figcaption><span>Doomsday timeline</span><small>Seconds · source defaults</small></figcaption>
          <div class="timeline-visual mt-5">
            {clockChart.map((item) => <div class="timeline-step"><span class={`timeline-dot ${item.color}`}></span><div><strong>{item.value}s</strong><span>{item.label}</span></div></div>)}
          </div>
          <p class="mt-4 text-xs leading-relaxed text-dawn/60">These phases are configuration values, not a substitute for the full Doomsday Clock explanation.</p>
        </figure>
      </section>

      <div class="mt-8 space-y-8" data-pagefind-body>
        {GITHUB_GAME_DATA.sections.map((section) => (
          <section>
            <div class="mb-3">
              <h2 class="font-display text-2xl font-bold text-white">{section.title}</h2>
              <p class="mt-1 text-sm text-dawn/70">{section.description}</p>
            </div>
            <div class="overflow-x-auto rounded-xl border border-white/10">
              <table class="w-full min-w-[520px] text-left text-sm">
                <thead class="bg-navy-700/80 text-xs uppercase tracking-wider text-dawn/60"><tr><th class="px-4 py-3">Value</th><th class="px-4 py-3">Current data</th><th class="px-4 py-3">Source</th></tr></thead>
                <tbody class="divide-y divide-white/10 bg-navy-700/40">
                  {section.entries.map((entry) => (
                    <tr><th scope="row" class="px-4 py-3 font-medium text-white">{entry.label}</th><td class="px-4 py-3 text-aquarius">{entry.value}</td><td class="px-4 py-3"><a href={githubSourceUrl(entry.source)} target="_blank" rel="noopener noreferrer" class="text-dawn/70 hover:text-white">{entry.source} ↗</a></td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))}
      </div>

      <section class="mt-10 border-t border-white/10 pt-6" data-pagefind-ignore>
        <h2 class="font-display text-xl font-bold text-white">Reference files</h2>
        <ul class="mt-3 space-y-2 text-sm text-dawn/70">
          {GITHUB_GAME_DATA.files.map((file) => <li><a href={file.url} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">{file.path}</a> <span>({file.label})</span></li>)}
          {GITHUB_SOURCE_FILES.filter((file) => !GITHUB_GAME_DATA.files.some((known) => known.path === file.path)).map((file) => <li><a href={file.url} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">{file.path}</a> <span>({file.label})</span></li>)}
        </ul>
      </section>
    </main>
  </div>

  <SiteFooter />
</Layout>