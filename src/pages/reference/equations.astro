---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrowseSidebar from "../../components/BrowseSidebar.astro";
import { EQUATION_AUDIT, equationSourceUrl } from "../../data/equation-audit.js";
---

<Layout title="Equation Reference — OpenFront Wiki" description="Current OpenFront gameplay equations verified against the live source, with historical context clearly separated.">
  <SiteHeader />
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore><details open><summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">Browse Pages <span class="lg:hidden">▾</span></summary><BrowseSidebar /></details></aside>
    <main class="min-w-0">
      <nav class="mb-6 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore><a href="/" class="hover:text-aquarius">Home</a><span>/</span><span class="text-dawn">Equation audit</span></nav>
      <header class="border-b border-white/10 pb-8"><p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Data reference</p><h1 class="mt-2 font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">Equation reference</h1><p class="mt-3 max-w-3xl text-base leading-relaxed text-dawn/80">Current formulas are checked against OpenFrontIO commit {EQUATION_AUDIT.revision.slice(0, 7)}. Older formula-like prose is labeled as historical context.</p></header>
      <div class="mt-8 space-y-4" data-pagefind-body>
        {EQUATION_AUDIT.entries.map((entry) => <article class:list={["equation-audit-card", entry.status === "historical" && "equation-audit-historical"]}><div class="flex flex-wrap items-center justify-between gap-3"><h2>{entry.name}</h2><span class="equation-status">{entry.status}</span></div><code class="equation-audit-formula">{entry.formula}</code><p>{entry.meaning}</p><div class="flex flex-wrap gap-4 text-xs"><a href={equationSourceUrl(entry.source)} target={entry.source.startsWith("/") ? undefined : "_blank"} rel={entry.source.startsWith("/") ? undefined : "noopener noreferrer"} class="text-aquarius hover:text-white">Source ↗</a><a href={entry.guide} class="text-aquarius hover:text-white">Reader guide →</a></div></article>)}
      </div>
    </main>
  </div>
  <SiteFooter />
</Layout>