---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrowseSidebar from "../../components/BrowseSidebar.astro";
import { REFERENCE_PAGES } from "../../data/reference-pages.js";

export function getStaticPaths() {
  return REFERENCE_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<Layout title={`${page.title} — OpenFront Wiki`} description={page.description}>
  <SiteHeader />
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore>
      <details open><summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">Browse Pages <span class="lg:hidden">▾</span></summary><BrowseSidebar /></details>
    </aside>
    <main class="min-w-0">
      <nav class="mb-6 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore><a href="/" class="hover:text-aquarius">Home</a><span>/</span><span class="text-dawn">{page.title}</span></nav>
      <header class="border-b border-white/10 pb-8"><p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">{page.kicker}</p><h1 class="mt-2 font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">{page.title}</h1><p class="mt-3 max-w-3xl text-base leading-relaxed text-dawn/80">{page.description}</p></header>
      <div class="mt-8 space-y-8" data-pagefind-body>
        {page.facts && (
          <section class="rounded-xl border border-malibu/30 bg-malibu/10 p-5">
            <h2 class="font-display text-xl font-bold text-white">Current scope</h2>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-dawn/80">{page.facts.map((fact) => <li class="flex gap-2"><span class="text-cyan-glow">▸</span><span>{fact}</span></li>)}</ul>
          </section>
        )}
        {page.sections.map((section) => <section><h2 class="font-display text-2xl font-bold text-white">{section.title}</h2><div class="mt-3 grid gap-3 sm:grid-cols-2">{section.links.map(([label, href]) => <a href={href} class="group rounded-xl border border-white/10 bg-navy-700/50 p-4 transition-colors hover:border-malibu/50 hover:bg-navy-600/70"><span class="font-display text-lg font-semibold text-white group-hover:text-aquarius">{label}</span><span class="mt-1 block text-sm text-dawn/60">Open reference →</span></a>)}</div></section>)}
      </div>
      <p class="mt-10 border-t border-white/10 pt-5 text-sm text-dawn/60">Primary source: <a href={page.source} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">OpenFrontIO on GitHub ↗</a></p>
    </main>
  </div>
  <SiteFooter />
</Layout>