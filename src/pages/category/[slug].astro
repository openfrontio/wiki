---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrowseSidebar from "../../components/BrowseSidebar.astro";
import pages from "../../data/pages.json";
import { pagesForCategory, WIKI_CATEGORIES } from "../../lib/categories.js";

export function getStaticPaths() {
  return WIKI_CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = pagesForCategory(pages, category);
const groups = [...new Set(items.map((page) => page.section || (page.source === "liquipedia" ? "Community" : "Other")))];
---

<Layout title={`${category.title} — OpenFront Wiki`} description={category.description}>
  <SiteHeader />

  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)] xl:grid-cols-[230px_minmax(0,1fr)_200px]">
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore>
      <details open>
        <summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">
          Browse Pages <span class="lg:hidden">▾</span>
        </summary>
        <BrowseSidebar />
      </details>
    </aside>

    <main class="min-w-0">
      <nav class="mb-6 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore>
        <a href="/" class="hover:text-aquarius">Home</a>
        <span>/</span>
        <span class="text-dawn">{category.title}</span>
      </nav>

      <header class="border-b border-white/10 pb-8">
        <div class="flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-malibu/40 bg-malibu/10 font-display text-2xl text-cyan-glow" aria-hidden="true">{category.icon}</span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Wiki category</p>
            <h1 class="mt-2 font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">{category.title}</h1>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-dawn/80">{category.description}</p>
          </div>
        </div>
      </header>

      <div class="mt-8 flex items-center justify-between gap-4">
        <h2 class="font-display text-2xl font-bold text-white">Articles</h2>
        <span class="text-sm text-dawn/60">{items.length} {items.length === 1 ? "article" : "articles"}</span>
      </div>

      {items.length > 0 ? (
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {groups.map((group) => (
            <section class="contents">
              {items.filter((page) => (page.section || (page.source === "liquipedia" ? "Community" : "Other")) === group).map((page) => (
                <a href={`/${page.slug}`} class="group rounded-xl border border-white/10 bg-navy-700/50 p-4 transition-all hover:-translate-y-0.5 hover:border-malibu/50 hover:bg-navy-600/70">
                  <span class="text-xs font-semibold uppercase tracking-widest text-cyan-glow/80">{group}</span>
                  <h3 class="mt-2 font-display text-lg font-semibold text-white group-hover:text-aquarius">{page.title}</h3>
                  <span class="mt-3 inline-block text-xs text-dawn/50">Read article →</span>
                </a>
              ))}
            </section>
          ))}
        </div>
      ) : (
        <p class="mt-6 rounded-xl border border-white/10 bg-navy-700/50 p-5 text-sm text-dawn/70">This category is ready for new articles.</p>
      )}

      <div class="mt-10 border-t border-white/10 pt-5 text-sm text-dawn/60">
        Looking for something else? <a href="/all" class="text-aquarius hover:text-white">Browse all pages</a> or use the wiki search.
      </div>
    </main>

    <aside class="hidden xl:block" data-pagefind-ignore>
      <div class="sticky top-20">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-cyan-glow">Wiki map</p>
        <ul class="space-y-1.5 border-l border-white/10 text-sm">
          {WIKI_CATEGORIES.map((entry) => (
            <li><a href={`/category/${entry.slug}`} class:list={["block border-l-2 border-transparent py-0.5 pl-3 text-dawn/70 hover:border-malibu hover:text-white", entry.slug === category.slug && "border-malibu text-white"]}>{entry.title}</a></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>

  <SiteFooter />
</Layout>
---