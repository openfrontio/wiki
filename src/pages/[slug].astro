---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BrowseSidebar from "../components/BrowseSidebar.astro";
import pages from "../data/pages.json";
import { articleAudience, articleLead, cleanArticleHtml, pageDescription } from "../lib/meta.js";
import { githubReferencesForPage } from "../data/github-references.js";
import { currentGameDataForPage, GITHUB_GAME_DATA } from "../data/github-game-data.js";
import { mapPresentation } from "../lib/mapMeta.js";
import mapCatalog from "../data/map-catalog.json";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const metaDescription = pageDescription(page.html);
const lead = articleLead(page.html);
const audience = articleAudience(page);
const mapInfo = page.section === "Maps" ? mapPresentation(page) : null;
const mapRecord = mapInfo ? mapCatalog.maps.find((map) => map.title.toLowerCase().replace(/[^a-z0-9]/g, "") === page.title.toLowerCase().replace(/[^a-z0-9]/g, "")) : null;
const githubReferences = githubReferencesForPage(page);
const currentGameData = currentGameDataForPage(page.slug);

// On the OpenFront Masters hub page, list the mirrored Masters pages by group.
const isMastersHub = page.slug === "OpenFront_Masters";
const mastersGroups = isMastersHub
  ? (() => {
      const masters = pages.filter((p) => (p.cats || []).includes("OpenFront Masters"));
      const pick = (sub) => masters.filter((p) => (p.cats || []).includes(sub)).sort((a, b) => a.title.localeCompare(b.title));
      return [
        { label: "OFM Official Tournaments", items: pick("OFM Official") },
        { label: "Community Tournaments", items: pick("Community") },
        { label: "Teams", items: pick("Teams") },
        { label: "Players", items: pick("Players") },
      ].filter((g) => g.items.length);
    })()
  : [];

// Hide MediaWiki maintenance categories; keep topical ones only.
const MAINT = /stub|broken file|hatnote|disambiguation|^all |^pages with|^articles with/i;
const topicalCats = (page.cats || []).filter((c) => !MAINT.test(c));
const relatedPages = pages
  .filter((candidate) => candidate.slug !== page.slug && candidate.source !== "liquipedia" && candidate.section === page.section)
  .sort((a, b) => a.title.localeCompare(b.title))
  .slice(0, 4);
---

<Layout title={`${page.title} — OpenFront Wiki`} description={metaDescription}>
  <SiteHeader />

  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)] xl:grid-cols-[230px_minmax(0,1fr)_200px]">
    <!-- Left: browse + search -->
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore>
      <details open>
        <summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">
          Browse Pages <span class="lg:hidden">▾</span>
        </summary>
        <BrowseSidebar currentSlug={page.slug} />
      </details>
    </aside>

    <!-- Center: article -->
    <main class="min-w-0">
      <nav class="mb-4 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore>
        <a href="/" class="hover:text-aquarius">Home</a>
        <span>/</span>
        <a href="/all" class="hover:text-aquarius">All Pages</a>
        <span>/</span>
        <span class="text-dawn">{page.title}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">
          {page.title}
        </h1>
      </div>

      <section class="article-quick-read mt-5" data-pagefind-ignore>
        <div class="article-quick-read-heading">
          <span class="article-eyebrow">Quick read</span>
          <span class="article-length">{page.headings.length > 4 ? "Detailed reference" : "Focused reference"}</span>
        </div>
        <p>{lead || "This page is part of the OpenFront Wiki reference library."}</p>
        <div class="article-audience">
          {audience.map((label) => <span>{label}</span>)}
        </div>
      </section>

      {
        topicalCats.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {topicalCats.map((c) => (
              <span class="rounded-full border border-white/10 bg-navy-700/60 px-2.5 py-0.5 text-xs font-medium text-dawn/80">
                {c}
              </span>
            ))}
          </div>
        )
      }

      <div class="mt-5 h-px w-full bg-gradient-to-r from-malibu/50 via-white/10 to-transparent"></div>

      {mapInfo && (
        <figure class="map-article-hero mt-6" data-pagefind-ignore>
          {mapInfo.image ? <img src={mapInfo.image} alt={`${page.title} map preview`} loading="lazy" /> : <div class="map-preview-fallback" aria-label={`${page.title} map preview`}>{page.title}</div>}
          <figcaption>{mapInfo.description}</figcaption>
        </figure>
      )}

      {mapRecord && (
        <figure class="map-data-visual mt-4" data-pagefind-ignore>
          <figcaption><span>Map profile</span><small>Live registry data</small></figcaption>
          <div class="map-data-bars">
            <div><span>Default nations</span><strong>{mapRecord.nations}</strong><i style={`width: ${Math.min(100, mapRecord.nations * 4)}%`}></i></div>
            <div><span>FFA frequency</span><strong>{mapRecord.ffaFrequency < 0 ? "Special" : mapRecord.ffaFrequency}</strong><i style={`width: ${Math.min(100, Math.max(8, mapRecord.ffaFrequency * 10))}%`}></i></div>
            <div><span>Team frequency</span><strong>{mapRecord.teamFrequency < 0 ? "Special" : mapRecord.teamFrequency}</strong><i style={`width: ${Math.min(100, Math.max(8, mapRecord.teamFrequency * 10))}%`}></i></div>
          </div>
        </figure>
      )}

      <article class="wiki-content mt-6" set:html={cleanArticleHtml(page.html)} data-pagefind-body data-pagefind-meta={`title:${page.title}`} />

      {page.slug === "Early_Game" && (
        <section class="guide-callout mt-8" data-pagefind-ignore>
          <strong>This legacy page has been expanded.</strong>
          <p class="mt-2">Use the current <a href="/guides/early-game" class="text-aquarius hover:text-white">Early Game Guide</a> for source-backed opening priorities, capacity management, and your first safe attack.</p>
        </section>
      )}


      {currentGameData.length > 0 && (
        <section class="mt-8 border-t border-white/10 pt-5" data-pagefind-ignore>
          <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Current source values</p>
          <p class="mt-2 text-sm text-dawn/60">Verified against OpenFrontIO commit {GITHUB_GAME_DATA.revision.slice(0, 7)} on {GITHUB_GAME_DATA.checkedAt}. Costs and timings can change with balance updates.</p>
          <div class="mt-3 overflow-x-auto rounded-xl border border-white/10">
            <table class="w-full min-w-[520px] text-left text-sm">
              <thead class="bg-navy-700/80 text-xs uppercase tracking-wider text-dawn/60"><tr><th class="px-4 py-3">Value</th><th class="px-4 py-3">Current data</th><th class="px-4 py-3">Source</th></tr></thead>
              <tbody class="divide-y divide-white/10 bg-navy-700/40">
                {currentGameData.map((entry) => <tr><th scope="row" class="px-4 py-3 font-medium text-white">{entry.label}</th><td class="px-4 py-3 text-aquarius">{entry.value}</td><td class="px-4 py-3"><a href={`https://github.com/openfrontio/OpenFrontIO/blob/ccf2bd9a412b0be4360f1b68d8b6a20573c297f6/src/core/configuration/${entry.source.split("#")[0]}#${entry.source.split("#")[1]}`} target="_blank" rel="noopener noreferrer" class="text-dawn/70 hover:text-white">{entry.source} ↗</a></td></tr>)}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {githubReferences.length > 0 && (
        <section class="mt-8 border-t border-white/10 pt-5" data-pagefind-ignore>
          <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Current code references</p>
          <p class="mt-2 text-sm text-dawn/60">This article's game mechanics can be cross-checked against the OpenFrontIO source:</p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
            {githubReferences.map((reference) => (
              <li><a href={reference.url} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">{reference.label} <span aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </section>
      )}

      {relatedPages.length > 0 && (
        <section class="mt-8 border-t border-white/10 pt-5" data-pagefind-ignore>
          <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Keep reading</p>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {relatedPages.map((related) => <a href={`/${related.slug}`} class="rounded-lg border border-white/10 bg-navy-700/40 px-3 py-2 text-sm text-dawn/80 transition-colors hover:border-malibu/50 hover:text-white">{related.title} <span class="text-dawn/40">→</span></a>)}
          </div>
        </section>
      )}

      {isMastersHub && mastersGroups.length > 0 && (
        <div class="wiki-content mt-8">
          {mastersGroups.map((g) => (
            <section class="mb-6">
              <h2 class="font-display text-xl font-bold text-white">{g.label}</h2>
              <ul class="mt-2 grid gap-1 sm:grid-cols-2">
                {g.items.map((p) => (
                  <li>
                    <a href={`/${p.slug}`} class="text-aquarius hover:text-white">{p.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}

      <div class="mt-10 border-t border-white/10 pt-5 text-xs text-dawn/50">
        {page.source === "liquipedia" ? (
          <span>
            This page uses material from
            <a href={page.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">Liquipedia</a>,
            licensed under
            <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">CC BY-SA 3.0</a>.
          </span>
        ) : (
          <span>
            Content from the OpenFront community wiki, available under
            <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="text-aquarius hover:text-white">CC BY-SA 4.0</a>.
          </span>
        )}
      </div>
    </main>

    <!-- Right: table of contents -->
    {
      page.headings.length > 1 && (
        <aside class="hidden xl:block" data-pagefind-ignore>
          <div class="sticky top-20">
            <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-cyan-glow">
              On this page
            </p>
            <ul class="space-y-1.5 border-l border-white/10 text-sm">
              {page.headings.map((h) => (
                <li>
                  <a
                    href={`#${h.id}`}
                    class:list={[
                      "-ml-px block border-l-2 border-transparent py-0.5 text-dawn/70 transition-colors hover:border-malibu hover:text-white",
                      h.level === 3 ? "pl-6" : "pl-3",
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )
    }
  </div>

  <SiteFooter />
</Layout>

<script>
  // Liquipedia toggle-areas (group/bracket view switchers): Liquipedia shows one
  // view and switches via JS; without it every view stacks. Re-implement the
  // switch so only the active view shows and the pills work. No-op on pages
  // without toggle-areas.
  const SCOPE = '[data-toggle-area]:not([data-toggle-area=""])';
  document.querySelectorAll(SCOPE).forEach((area) => {
    const n = area.getAttribute("data-toggle-area");
    const own = (sel: string) =>
      Array.from(area.querySelectorAll(sel)).filter((el) => el.closest(SCOPE) === area);
    const contents = own("[data-toggle-area-content]") as HTMLElement[];
    const pills = own(`[data-toggle-area-btn="${n}"]`) as HTMLElement[];
    if (contents.length < 2 && pills.length < 2) return; // nothing to switch
    const active = pills.find((p) => p.classList.contains("switch-pill-option-active"));
    let val = active?.getAttribute("data-switch-value") ?? "1";
    const apply = () => {
      contents.forEach((c) => {
        c.style.display = c.getAttribute("data-toggle-area-content") === val ? "" : "none";
      });
      pills.forEach((p) =>
        p.classList.toggle(
          "switch-pill-option-active",
          p.getAttribute("data-switch-value") === val,
        ),
      );
    };
    pills.forEach((p) =>
      p.addEventListener("click", () => {
        val = p.getAttribute("data-switch-value") ?? val;
        apply();
      }),
    );
    apply();
  });
</script>
